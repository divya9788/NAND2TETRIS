/**
 * Hack Memory chip:
 * Maps the 15-bit address space onto RAM16K (0x0000-0x3FFF),
 * Screen (0x4000-0x5FFF), and Keyboard (0x6000).
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Address bit 14 splits lower 16K RAM from memory-mapped I/O.
    DMux(in=load, sel=address[14], a=loadRam, b=loadIo);
    // Address bit 13 distinguishes Screen (0) from Keyboard (1, read-only).
    DMux(in=loadIo, sel=address[13], a=loadScreen, b=unusedKbdLoad);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux16(a=screenOut, b=kbdOut, sel=address[13], out=ioOut);
    Mux16(a=ramOut, b=ioOut, sel=address[14], out=out);
}
